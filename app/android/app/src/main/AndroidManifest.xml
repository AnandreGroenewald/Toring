<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- (28 Oct 2026, the emulator's Pixel Tablet: Android 16 ignores a portrait lock on screens 600 dp and wider unless
         the app says it is a game) appCategory="game" keeps Stapel upright there too -->
    <application
        android:appCategory="game"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Challenge links (?kamer=, ?teen=, ?klop=) open in the app (Android App Links, verified
                 through https://stapelspel.pages.dev/.well-known/assetlinks.json, which the Pages build
                 serves). Only the game's own page: the privacy and sponsor pages stay in the browser.
                 Links to the old address (anandregroenewald.github.io/Toring/) open in the browser and
                 forward there (js/moved.js). app/shim.js hands the link to the game. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="stapelspel.pages.dev" android:path="/" />
                <data android:scheme="https" android:host="stapelspel.pages.dev" android:path="/index.html" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- (27 Oct 2026) News on the phone (StapelPushPlugin): Firebase stays asleep until the player allows
             notifications; its messages use the reminder's icon and a "Nuus / News" channel. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_stapel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="news" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the game's Vibrasie setting (navigator.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the daily reminder (LocalNotifications) asks for POST_NOTIFICATIONS itself; it never needs
         exact alarms (Google Play allows those only for alarm and calendar apps), so that goes -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- (1.14) androidx.credentials brings these for its own passkey/fingerprint prompts; Stapel only uses Google's
         account picker (Sign in with Google), so the game never asks for a fingerprint -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
</manifest>
